{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["/opt/node-tools/node_modules/@types", "node_modules/@types"],
    "types": ["node"],
    "paths": {
      "@poker/engine": ["../packages/engine/dist/index"]
    }
  },
  "include": ["src/**/*.ts"]
}
